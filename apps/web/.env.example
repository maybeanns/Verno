# Copy to .env.local and fill in your own values. Never commit .env.local.

# ── Shared API key (funds the free tier) ─────────────────────────────────────
# Used only for "Generate PRD" runs by signed-in accounts, 1 per day.
# Plan / Develop / SDLC always require the user's own key.
GROQ_API_KEY=

# ── Supabase (accounts + free-tier metering) ─────────────────────────────────
# Without these, account UI is hidden and the free tier is unavailable;
# users can still bring their own API keys for every mode.
# Both values are in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional but recommended in production: lets the server write usage rows
# independently of the caller's session.
# This key bypasses Row Level Security. Keep it server-side only, never expose
# it to the browser, and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Turnstile ("are you human") ───────────────────────────────────
# Site key is public and goes here. The SECRET key is NOT used by this app:
# paste it into Supabase → Authentication → Attack Protection → CAPTCHA.
# Leave blank to disable the check (widget is hidden, signup still works).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# No app-side env needed. Client ID + secret go into
# Supabase → Authentication → Sign In / Providers → Google.
