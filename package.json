{
  "name": "verno-monorepo",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maybeanns/AI-App-Builder-with-Agentic-Debate"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build -w @verno/agents -w @verno/llm",
    "dev:web": "npm run dev -w @verno/web",
    "build:web": "npm run build -w @verno/web",
    "build:extension": "npm run compile -w verno",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "package:extension": "node scripts/package-extension.mjs"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.0",
    "postcss": "^8.5.26"
  }
}
